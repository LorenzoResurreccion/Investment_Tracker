# Back-end API base URL (optional, defaults to /api)
VITE_API_BASE_URL=/api

# WebSocket URL for real-time prices (optional, defaults to ws://localhost:8080/ws/prices in dev)
VITE_WS_URL=ws://localhost:8080/ws/prices

# AWS Cognito (required for authentication)
VITE_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_cognito_client_id_here
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
