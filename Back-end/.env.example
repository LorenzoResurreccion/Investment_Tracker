# Finnhub API key (required) — get yours at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Set to false to disable the Finnhub WebSocket connection
FINNHUB_ENABLED=true

# PostgreSQL database connection (required)
DATABASE_URL=jdbc:postgresql://localhost:5432/investment_tracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# Server port (optional, defaults to 8080)
SERVER_PORT=8080

# CORS — allowed front-end origin (optional, defaults to http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# AWS Cognito (required for authentication)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
